OPENAI_API_KEY=
# Set to 1 to switch on the curation agent and its panel; unset answers the curate route with 501 and never loads the agent SDK.
LLM_ENABLED=
# Set to 1 for static mode: a records app for a browser agent with no catalog search and no server-side store call; the agent reads the store's page itself (docs/agent-playbook.md).
TOKUCHU_STATIC=
CUSTOMILY_SHOP_URL=
# Shopify GraphQL Admin API via the client credentials grant (issue #1). The app and store must be
# in the same Shopify organization. The client id (API key) and client secret (API secret key,
# shpss_) mint a 24h access token at {store}/admin/oauth/access_token, used as X-Shopify-Access-Token.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ADMIN_API_VERSION=
# Postgres for the persisted events; unset outside production keeps events in this process's memory.
DATABASE_URL=
# Signs the session cookie; `npx auth secret` makes one. Unset outside production uses a development secret.
AUTH_SECRET=
# The public origin the magic link points at, such as https://tokuchu.onrender.com; unset infers it from the request.
AUTH_URL=
# Resend sends the magic link in production; unset or outside production logs the link to the server console.
RESEND_API_KEY=
# The sender address for the magic link; unset uses no-reply@tokuchu.app.
AUTH_EMAIL_FROM=
# Set to 1 to send attendee requests through Resend outside production; unset logs each message to the server console.
MAIL_LIVE=
# The public origin the attendee links in request emails point at; unset falls back to AUTH_URL and then http://localhost:3113.
APP_URL=
# Comma-separated addresses that may sign in, matched case-insensitively; unset or empty lets any address create an account.
ORGANIZER_EMAILS=
# The port the built server listens on; Render sets it, and `next dev` and `next start` use their own `-p` flag.
PORT=
